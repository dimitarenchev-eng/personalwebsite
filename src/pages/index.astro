  <script type="module" is:inline>
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(hover: none)').matches;

    // ---------- Lenis smooth scroll (dynamic import with graceful fallback) ----------
    let lenis = null;
    if (!prefersReduced) {
      try {
        const { default: Lenis } = await import('https://esm.sh/lenis@1.1.20');
        lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
        const raf = (time) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // Smooth-scroll for in-page anchor links
        document.querySelectorAll('a[href^="#"]').forEach((a) => {
          a.addEventListener('click', (e) => {
            const id = a.getAttribute('href');
            if (id && id.length > 1) {
              const target = document.querySelector(id);
              if (target) {
                e.preventDefault();
                lenis.scrollTo(target, { offset: -40 });
              }
            }
          });
        });
      } catch (err) {
        console.warn('Lenis unavailable; falling back to native scroll', err);
      }
    }

    // ---------- Fractal web (the single ambient background element) ----------
    // Renders a sparse node-link network across the viewport. The cursor
    // brightens nodes + lines within a soft radius — no separate cursor
    // marker; the cursor effect IS the web.
    {
      const canvas = document.querySelector('.fractal-web');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        let W = 0, H = 0;
        let nodes = [];
        const NODE_COUNT_BASE = 70;
        const CONN_DIST = 170;
        const BASE_DRIFT = 0.16;
        const CURSOR_REACH = 260;      // px — radius of cursor's "torch"
        const PARALLAX_MAX = 9;        // px — max canvas drift toward cursor
        const PARALLAX_LERP = 0.045;   // smoothing factor (lower = laggier)
        let scrollShimmer = 0;
        let cursorX = -10000, cursorY = -10000;
        let cursorActive = false;
        let canvasOffsetX = 0, canvasOffsetY = 0;

        function setup() {
          const area = window.innerWidth * window.innerHeight;
          const count = Math.round(NODE_COUNT_BASE * (area / (1280 * 800)));
          W = window.innerWidth;
          H = window.innerHeight;
          canvas.width = W * dpr;
          canvas.height = H * dpr;
          canvas.style.width = W + 'px';
          canvas.style.height = H + 'px';
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.scale(dpr, dpr);
          nodes = [];
          for (let i = 0; i < Math.max(40, Math.min(140, count)); i++) {
            const angle = Math.random() * Math.PI * 2;
            nodes.push({
              x: Math.random() * W,
              y: Math.random() * H,
              vx: Math.cos(angle) * BASE_DRIFT,
              vy: Math.sin(angle) * BASE_DRIFT,
              r: 0.7 + Math.random() * 1.2,
              phase: Math.random() * Math.PI * 2,
            });
          }
        }

        function tickFrame(t) {
          ctx.clearRect(0, 0, W, H);
          scrollShimmer *= 0.92;
          const shimmerNudge = scrollShimmer * 0.012;

          // Subtle canvas parallax — drift the whole mesh toward cursor
          const targetOX = cursorActive ? (cursorX / W - 0.5) * PARALLAX_MAX * 2 : 0;
          const targetOY = cursorActive ? (cursorY / H - 0.5) * PARALLAX_MAX * 2 : 0;
          canvasOffsetX += (targetOX - canvasOffsetX) * PARALLAX_LERP;
          canvasOffsetY += (targetOY - canvasOffsetY) * PARALLAX_LERP;
          canvas.style.transform =
            'translate3d(' + canvasOffsetX.toFixed(2) + 'px, ' + canvasOffsetY.toFixed(2) + 'px, 0)';

          // Update node positions
          for (const n of nodes) {
            n.x += n.vx + (Math.sin(n.phase + t * 0.0003) * 0.04);
            n.y += n.vy + shimmerNudge;
            if (n.x < -10) n.x = W + 10;
            if (n.x > W + 10) n.x = -10;
            if (n.y < -10) n.y = H + 10;
            if (n.y > H + 10) n.y = -10;
          }

          // Cursor-local coords (compensate for the canvas translate)
          const localCx = cursorX - canvasOffsetX;
          const localCy = cursorY - canvasOffsetY;

          // Pre-compute cursor proximity per node
          const prox = new Array(nodes.length);
          for (let i = 0; i < nodes.length; i++) {
            if (!cursorActive) { prox[i] = 0; continue; }
            const dx = nodes[i].x - localCx;
            const dy = nodes[i].y - localCy;
            const d2 = dx * dx + dy * dy;
            prox[i] = d2 > CURSOR_REACH * CURSOR_REACH
              ? 0
              : 1 - Math.sqrt(d2) / CURSOR_REACH;
          }

          // Lines between nearby nodes — softened cursor boost
          for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
              const dx = nodes[i].x - nodes[j].x;
              const dy = nodes[i].y - nodes[j].y;
              const d2 = dx * dx + dy * dy;
              if (d2 < CONN_DIST * CONN_DIST) {
                const d = Math.sqrt(d2);
                const baseAlpha = (1 - d / CONN_DIST) * 0.13;
                const boost = (prox[i] + prox[j]) * 0.5;
                const a = baseAlpha * (1 + boost * 1.5);
                ctx.strokeStyle = 'rgba(244, 185, 66, ' + Math.min(0.5, a).toFixed(3) + ')';
                ctx.lineWidth = 0.5 + boost * 0.2;
                ctx.beginPath();
                ctx.moveTo(nodes[i].x, nodes[i].y);
                ctx.lineTo(nodes[j].x, nodes[j].y);
                ctx.stroke();
              }
            }
          }

          // Nodes — softer cursor boost
          for (let i = 0; i < nodes.length; i++) {
            const n = nodes[i];
            const breath = 0.55 + 0.25 * Math.sin(n.phase + t * 0.0008);
            const baseAlpha = 0.26 * breath;
            const a = baseAlpha * (1 + prox[i] * 1.3);
            const r = n.r * (1 + prox[i] * 0.4);
            ctx.fillStyle = 'rgba(244, 185, 66, ' + Math.min(0.6, a).toFixed(3) + ')';
            ctx.beginPath();
            ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
            ctx.fill();
          }

          if (!prefersReduced) requestAnimationFrame(tickFrame);
        }

        // Cursor tracking
        window.addEventListener('pointermove', (e) => {
          cursorX = e.clientX;
          cursorY = e.clientY;
          cursorActive = true;
        }, { passive: true });
        window.addEventListener('pointerleave', () => { cursorActive = false; });
        window.addEventListener('blur',         () => { cursorActive = false; });

        window.addEventListener('resize', setup, { passive: true });
        setup();

        if (prefersReduced) {
          tickFrame(0); // single static frame
        } else {
          if (lenis) {
            lenis.on('scroll', ({ velocity }) => {
              scrollShimmer = Math.min(20, scrollShimmer + Math.abs(velocity) * 4);
            });
          } else {
            let lastY = window.scrollY;
            window.addEventListener('scroll', () => {
              const dy = window.scrollY - lastY;
              lastY = window.scrollY;
              scrollShimmer = Math.min(20, scrollShimmer + Math.abs(dy) * 0.5);
            }, { passive: true });
          }
          requestAnimationFrame(tickFrame);
        }
      }
    }

    // ---------- Magnetic buttons: subtle pull toward cursor ----------
    if (!prefersReduced && !isTouch) {
      const magneticEls = document.querySelectorAll('.btn, .nav-links a, .venture-name a');
      magneticEls.forEach((el) => {
        let rafM = null;
        let dx = 0, dy = 0;
        const apply = () => {
          el.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
          rafM = null;
        };
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          const cx = r.left + r.width / 2;
          const cy = r.top + r.height / 2;
          // Pull strength: 22% of distance from element center toward cursor
          dx = (e.clientX - cx) * 0.22;
          dy = (e.clientY - cy) * 0.22;
          if (!rafM) rafM = requestAnimationFrame(apply);
        }, { passive: true });
        el.addEventListener('pointerleave', () => {
          dx = 0; dy = 0;
          el.style.transform = '';
        });
      });
    }

    // ---------- Parallax (Lenis-driven if available, else native scroll) ----------
    const parallaxEls = document.querySelectorAll('[data-parallax]');
    function applyParallax(scroll) {
      parallaxEls.forEach((el) => {
        const speed = parseFloat(el.dataset.parallax) || 0;
        el.style.transform = `translate3d(0, ${scroll * speed}px, 0)`;
      });
    }
    if (lenis) {
      lenis.on('scroll', ({ scroll }) => applyParallax(scroll));
    } else if (!prefersReduced) {
      window.addEventListener('scroll', () => applyParallax(window.scrollY), { passive: true });
    }

    // ---------- Footer year ----------
    document.getElementById('year').textContent = new Date().getFullYear();

    // ---------- Scroll reveals ----------
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    // ---------- Hero stat counters (run on viewport entry) ----------
    const easeOutCubic = t => 1 - Math.pow(1 - t, 3);
    function runCounter(el) {
      const target = parseFloat(el.dataset.target);
      const prefix = el.dataset.prefix || '';
      const suffix = el.dataset.suffix || '';
      const dur = 1800;
      const start = performance.now();
      function step(now) {
        const t = Math.min(1, (now - start) / dur);
        const v = easeOutCubic(t) * target;
        el.textContent = prefix + (target % 1 === 0 ? Math.floor(v) : v.toFixed(1)) + suffix;
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    const statIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          // Delay to align with the hero stats fade-in (1.9s into the entrance sequence)
          setTimeout(() => runCounter(e.target), 200);
          statIO.unobserve(e.target);
        }
      });
    }, { threshold: 0.4 });
    document.querySelectorAll('.stat-num').forEach((el) => statIO.observe(el));

    // ---------- Venture cards: pointer-tracking radial glow ----------
    document.querySelectorAll('[data-mx-track]').forEach(el => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
        el.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
      });
    });

    // ---------- Card 3D tilt (Venture + Portfolio) ----------
    if (!isTouch) {
      const tiltMax = 6; // degrees
      document.querySelectorAll('.venture, .pf-item').forEach((card) => {
        let rafTilt = null;
        let pendingX = 0, pendingY = 0;
        const flushTilt = () => {
          card.style.setProperty('--ry', pendingX + 'deg');
          card.style.setProperty('--rx', pendingY + 'deg');
          rafTilt = null;
        };
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;  // -0.5..0.5
          const py = (e.clientY - r.top) / r.height - 0.5;
          pendingX =  px * tiltMax;
          pendingY = -py * tiltMax;
          if (!rafTilt) rafTilt = requestAnimationFrame(flushTilt);
        }, { passive: true });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });
    }

    // ---------- Cascading logo loader ----------
    function buildSources(domain) {
      return [
        `https://logo.clearbit.com/${domain}?size=256`,
        `https://cdn.brandfetch.io/${domain}/w/256/h/256?c=1idV5p2c0p_fmwQv2pp`,
        `https://www.google.com/s2/favicons?domain=${domain}&sz=128`,
        `https://icons.duckduckgo.com/ip3/${domain}.ico`
      ];
    }
    document.querySelectorAll('.pf-item').forEach(item => {
      const local = item.dataset.local;
      const domain = item.dataset.domain;
      const name = item.dataset.name || domain;
      const img = item.querySelector('.pf-logo');
      if (!img) return;

      // Local override: use the file we ship in /public, no remote fallback
      if (local) {
        img.src = local;
        return;
      }
      if (!domain) return;

      const sources = buildSources(domain);
      let i = 0;
      const tryNext = () => {
        if (i >= sources.length) {
          const fb = document.createElement('div');
          fb.className = 'pf-fallback';
          fb.textContent = name;
          img.replaceWith(fb);
          return;
        }
        img.src = sources[i++];
      };
      img.onerror = tryNext;
      tryNext();
    });
  </script>
</BaseLayout>
