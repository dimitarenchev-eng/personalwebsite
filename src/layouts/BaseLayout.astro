---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dimitar Enchev — Entrepreneur · Investor',
  description = 'Dimitar Enchev — Entrepreneur and investor at the intersection of deep tech, AI, Industry 4.0, and the energy transition. Cofounder & CEO of CWP Europe, Managing Partner at PostScriptum Ventures.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content="Dimitar Enchev" />
  <meta property="og:description" content="Entrepreneur and investor at the intersection of deep tech, AI, Industry 4.0, and the energy transition." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Dimitar Enchev" />
  <meta name="twitter:description" content="Entrepreneur and investor at the intersection of deep tech, AI, Industry 4.0, and the energy transition." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <canvas class="fractal-web" aria-hidden="true"></canvas>
  <slot />
</body>
</html>
